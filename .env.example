# ========================================
# Database Configuration
# ========================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://username:password@host:27017/?ssl=true&replicaSet=replica-set&authSource=admin

# ========================================
# Email Configuration (SMTP)
# ========================================
ADMIN_EMAIL=admin@ops.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@smtp-brevo.com
SMTP_PASS=your-smtp-password
SENDER_EMAIL=your-email@example.com

# ========================================
# Payment Gateway (Razorpay)
# ========================================
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret-key

# ========================================
# WhatsApp Cloud API Configuration
# ========================================
WHATSAPP_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
ADMIN_WHATSAPP_NUMBER=919xxxxxxxxxx

# ========================================
# Authentication & Security
# ========================================
# JWT Session Secret - Change to a long random string (min 32 chars)
JWT_SECRET=generate-a-secure-random-string-at-least-32-characters-long

# ========================================
# Cloudinary Configuration (Image Storage)
# ========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========================================
# Google OAuth (Gmail Integration)
# ========================================
# Register at: https://console.cloud.google.com
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/gmail/oauth?action=callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ========================================
# Application URLs
# ========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For production
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_SOCKET_URL=https://your-railway-socket-host.up.railway.app
# ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-railway-socket-host.up.railway.app

# ========================================
# Cron Jobs (Scheduled Tasks)
# ========================================
# Set this in deployment platform dashboard as well (Vercel/Railway)
CRON_SECRET=local_development_cron_secret_123

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=debug
NODE_ENV=development

# ========================================
# Zapier Automation Integration
# ========================================
# Webhook URL to trigger outbound automation zaps (e.g. catch hook)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/xxxxxx/
# Secure API Key for incoming webhook authentication (verify header x-api-key)
ZAPIER_API_KEY=your-secure-api-key-here
