# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========================================
# Environment & Secrets
# ========================================
# Local env files - NEVER commit secrets
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local
.env.*.example
*.key
*.pem
*.pfx
*.cert

# ========================================
# Dependencies & Package managers
# ========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
yarn.lock
pnpm-lock.yaml
bun.lockb

# ========================================
# Testing & Coverage
# ========================================
/coverage
/.nyc_output
*.lcov

# ========================================
# Build outputs
# ========================================
/.next
/out
/build
/dist
/*.tsbuildinfo

# ========================================
# Next.js & Vercel
# ========================================
next-env.d.ts
.vercel
.next/
.vercel/

# ========================================
# Logs
# ========================================
npm-debug.log*
npm-error.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log
/logs

# ========================================
# OS & IDE
# ========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
*.sublime-project
*.sublime-workspace

# ========================================
# Runtime & Process files
# ========================================
*.pid
*.seed
*.pid.lock

# ========================================
# Deployment & Infrastructure
# ========================================
.env.production
.env.staging
railway.json
.railway.json
/dist
/build
/public/uploads

# ========================================
# Development tools
# ========================================
.cache
.eslintcache
.node-persist

# ========================================
# Temporary files
# ========================================
*.tmp
*.bak
*.swp
.turbo
.eslintcache
