/**
 * lib/chat-sse.ts
 * Global in-memory SSE client registry for chat events & realtime presence tracking.
 * Survives Next.js hot module reloading (HMR) via global caching.
 *
 * Architecture note: works correctly for a single server process (local dev + single Vercel instance).
 * For multi-instance deployments, swap pushChatSSE with a Redis Pub/Sub broadcast.
 */

type Controller = ReadableStreamDefaultController<string>;

declare global {
  var _chatClients: Map<string, Set<Controller>> | undefined;
  var _presenceLastSeen: Map<string, number> | undefined;
  var _presenceInterval: NodeJS.Timeout | undefined;
}

// ── Global state (survives HMR) ───────────────────────────────────────────────

if (!global._chatClients)      global._chatClients      = new Map();
if (!global._presenceLastSeen) global._presenceLastSeen = new Map();

// IMPORTANT: never cache these in module-level consts.
// After Next.js HMR the module re-executes but `global` persists.
// Caching would make the new module copy hold a stale reference if the global
// was ever replaced. All functions must dereference `global._chatClients` directly.
function clients(): Map<string, Set<Controller>> { return global._chatClients!; }
function lastSeen(): Map<string, number>          { return global._presenceLastSeen!; }

// Presence cleanup every 15 s
if (!global._presenceInterval) {
  const iv = setInterval(cleanExpiredPresence, 15_000);
  if (typeof iv.unref === 'function') iv.unref();
  global._presenceInterval = iv;
}

// ── SSE Registration ──────────────────────────────────────────────────────────

export function registerChatSSEClient(userId: string, ctrl: Controller) {
  if (!clients().has(userId)) clients().set(userId, new Set());
  const set = clients().get(userId)!;
  const wasOffline = !isUserOnline(userId);
  set.add(ctrl);
  lastSeen().set(userId, Date.now());
  if (wasOffline) broadcastPresenceChange(userId, true);
}

export function unregisterChatSSEClient(userId: string, ctrl: Controller) {
  const set = clients().get(userId);
  if (set) {
    set.delete(ctrl);
    if (set.size === 0) clients().delete(userId);
  }
  // Let TTL or explicit disconnect mark offline — avoids flap on reconnect
}

// ── Presence ──────────────────────────────────────────────────────────────────

/** 45-second TTL — heartbeat sends every 15 s so 3 missed beats = offline */
const PRESENCE_TTL = 45_000;

export function isUserOnline(userId: string): boolean {
  if ((clients().get(userId)?.size ?? 0) > 0) return true;
  const t = lastSeen().get(userId);
  return !!t && Date.now() - t < PRESENCE_TTL;
}

export function touchUserPresence(userId: string) {
  const wasOffline = !isUserOnline(userId);
  lastSeen().set(userId, Date.now());
  if (wasOffline) broadcastPresenceChange(userId, true);
}

export function forceUserOffline(userId: string) {
  const wasOnline = isUserOnline(userId);
  clients().delete(userId);
  lastSeen().delete(userId);
  if (wasOnline) broadcastPresenceChange(userId, false);
}

export function getOnlineUserIds(): string[] {
  const now = Date.now();
  const online: string[] = [];
  // Active SSE connections
  for (const uid of clients().keys()) online.push(uid);
  // Recently-seen via heartbeat (no active SSE but still fresh)
  for (const [uid, ts] of lastSeen().entries()) {
    if (!clients().has(uid) && now - ts < PRESENCE_TTL) online.push(uid);
  }
  return [...new Set(online)];
}

export function cleanExpiredPresence() {
  const now = Date.now();
  for (const [userId, ts] of lastSeen().entries()) {
    const hasConn = (clients().get(userId)?.size ?? 0) > 0;
    if (!hasConn && now - ts > PRESENCE_TTL) {
      lastSeen().delete(userId);
      broadcastPresenceChange(userId, false);
    }
  }
}

// ── Broadcasting ──────────────────────────────────────────────────────────────

export function broadcastPresenceChange(userId: string, isOnline: boolean) {
  const payload = { type: 'presence_change', userId, isOnline };
  for (const uid of clients().keys()) {
    if (uid !== userId) pushChatSSE(uid, payload);
  }
}

/**
 * Push a JSON payload to all SSE controllers registered for userId.
 * Dead controllers are pruned automatically.
 * Returns true if at least one controller received the message.
 */
export function pushChatSSE(userId: string, data: object): boolean {
  const set = clients().get(userId);
  if (!set || set.size === 0) return false;

  const frame = `data: ${JSON.stringify(data)}\n\n`;
  const dead: Controller[] = [];

  for (const ctrl of set) {
    try {
      ctrl.enqueue(frame);
    } catch {
      dead.push(ctrl);
    }
  }

  for (const d of dead) set.delete(d);
  if (set.size === 0) {
    clients().delete(userId);
    return false;
  }
  return true;
}

/**
 * Broadcast to every participant in a list (except optionally one sender).
 */
export function pushToParticipants(
  participantIds: string[],
  data: object,
  excludeUserId?: string,
) {
  for (const uid of participantIds) {
    if (uid !== excludeUserId) pushChatSSE(uid, data);
  }
}
