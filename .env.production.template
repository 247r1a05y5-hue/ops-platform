# .env.production
# Copy this to .env.local on your VPS and fill in all values.
# This file is safe to commit (no secrets here, only key names).

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# No change from your existing .env.local — same Atlas connection string
MONGODB_URI=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Email (Brevo REST API) ────────────────────────────────────────────────────
BREVO_API_KEY=
SENDER_EMAIL=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Video calls ───────────────────────────────────────────────────────────────
DAILY_API_KEY=

# ── AI features ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Cron jobs (protect cron endpoints) ───────────────────────────────────────
CRON_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=

# ── WebRTC TURN (optional — metered.ca or your own TURN server) ───────────────
TURN_PROVIDER=free
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ── Zapier Automation (optional) ─────────────────────────────────────────────
ZAPIER_WEBHOOK_URL=
ZAPIER_API_KEY=
