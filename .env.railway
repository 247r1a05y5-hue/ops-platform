# ============================================================
# OPS Platform — Railway Environment Variables
# Copy these into your Railway service's Variables tab.
# Values marked REQUIRED will crash the app if missing.
# ============================================================

# ── Application ──────────────────────────────────────────────
# REQUIRED: Set this to your Railway public URL after first deploy
# e.g. https://ops-production-xxxx.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-railway-app.up.railway.app

# NEXT_PUBLIC_SOCKET_URL: leave blank — same-origin on Railway (combined server)
# Only set this if you ever split frontend and socket server to separate services
# NEXT_PUBLIC_SOCKET_URL=

# Disable Next.js telemetry in production
NEXT_TELEMETRY_DISABLED=1

NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
# REQUIRED: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ops?retryWrites=true&w=majority&appName=Cluster0

# ── Authentication ───────────────────────────────────────────
# REQUIRED: Long random string — at least 32 characters
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ── Email (SMTP via Brevo or similar) ────────────────────────
# REQUIRED for email features
ADMIN_EMAIL=admin@yourcompany.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-password
SENDER_EMAIL=noreply@yourcompany.com

# ── Cron Jobs ────────────────────────────────────────────────
# REQUIRED: protects /api/cron/* endpoints
# Generate with: openssl rand -hex 24
CRON_SECRET=replace-with-a-random-cron-secret

# ── Cloudinary (File / Image Storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Razorpay (Payments) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
ADMIN_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── Google OAuth (Gmail Integration) ────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── WebRTC TURN (optional — improves call reliability) ───────
# TURN_PROVIDER: free | coturn | twilio | xirsys | none
TURN_PROVIDER=free

# Twilio (if TURN_PROVIDER=twilio):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ── AI Features (optional) ───────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
